# Mai caricare file del gioco, ROM o file generati dalla build.
# Never commit game files, ROMs or build outputs.

# ROM e dump / ROMs and dumps
*.3ds
*.cci
*.cia
*.cxi
*.app
*.sav
*.dmp
*.bin
!scripts/**/*.bin

# work/: solo i dati di traduzione / only the translation data
work/*
!work/trad/
!work/glossary/
!work/img/
work/img/*
!work/img/labels/
work/img/labels/*
!work/img/labels/index.tsv
!work/v11/
work/v11/*
!work/v11/funcmap.tsv

# File di traduzione generati dalla build / translation files generated by the build
work/trad/batch_pages.json
work/trad/batch_errors.tsv
work/trad/manual_pages.json
work/trad/manual_rejected.tsv
work/trad/blob_trad.json
work/trad/blob_trad_ctx.json
work/trad/overflow.tsv
work/trad/shops_log.tsv
work/trad/batches/m006.tsv
work/trad/batches/m006.it.tsv

# Uscite della build / build outputs
build/
release/
local_paths.json

# Strumenti esterni (si scaricano a parte) / external tools (download separately)
tools/*
!tools/fonts/

# Python / sistema
__pycache__/
*.pyc
Thumbs.db
desktop.ini
.DS_Store
